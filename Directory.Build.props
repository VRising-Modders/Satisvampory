<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Authors>Satisvampory contributors</Authors>
    <Copyright>Copyright (c) 2026 Satisvampory contributors</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    Game and framework references for the plugin (ReferenceGame=true). Defaults fit a Steam
    install; override per machine in Directory.Build.local.props (git-ignored) or with
    VRISING_GAME_DIR / VRISING_INTEROP_DIR / PROGENITOR_DLL.
  -->
  <PropertyGroup>
    <VRisingGameDir Condition="'$(VRisingGameDir)' == '' and '$(VRISING_GAME_DIR)' != ''">$(VRISING_GAME_DIR)</VRisingGameDir>
    <VRisingGameDir Condition="'$(VRisingGameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\VRising</VRisingGameDir>
    <VRisingInteropDir Condition="'$(VRisingInteropDir)' == '' and '$(VRISING_INTEROP_DIR)' != ''">$(VRISING_INTEROP_DIR)</VRisingInteropDir>
    <VRisingInteropDir Condition="'$(VRisingInteropDir)' == ''">$(VRisingGameDir)\BepInEx\interop</VRisingInteropDir>
    <ProgenitorDll Condition="'$(ProgenitorDll)' == '' and '$(PROGENITOR_DLL)' != ''">$(PROGENITOR_DLL)</ProgenitorDll>
    <ProgenitorDll Condition="'$(ProgenitorDll)' == ''">$(VRisingGameDir)\BepInEx\progenitor-core\Progenitor.dll</ProgenitorDll>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
</Project>
